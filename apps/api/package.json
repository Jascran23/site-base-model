{
  "name": "@cms/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:section-registry && tsx watch --exclude ../web/** src/server.ts",
    "build:section-registry": "node ../../scripts/build-section-registry.mjs",
    "build": "npm run build -w @cms/shared && npm run build:section-registry && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "migrate": "tsx src/db/migrate.ts",
    "seed": "npm run build && node dist/db/seed.js",
    "install:master": "tsx src/scripts/create-master.ts",
    "typecheck": "npm run build -w @cms/shared && npm run build:section-registry && tsc --noEmit"
  },
  "dependencies": {
    "@cms/shared": "*",
    "argon2": "^0.41.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "file-type": "^22.3.0",
    "helmet": "^8.0.0",
    "multer": "^2.5.0",
    "mysql2": "^3.11.3",
    "sharp": "^0.35.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.3.0",
    "@types/node": "^20.16.10",
    "tsx": "^4.19.1",
    "vite": "^5.4.9",
    "typescript": "^5.6.2"
  }
}
