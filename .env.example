# ===== Instalação (copie para .env e preencha; NUNCA versione o .env) =====
PROJECT_NAME="Meu Cliente"
SITE_URL=http://localhost:5173
API_PORT=3001
NODE_ENV=development

# Banco MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=cms
DB_PASSWORD=troque-esta-senha
DB_NAME=cms_cliente

# Sessão (gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=troque-por-um-valor-aleatorio-de-64-caracteres-no-minimo-xxxxxxxxxxxxx
SESSION_TTL_HOURS=12

# Usuário master inicial (usado só por npm run install:master)
MASTER_NAME="Desenvolvedor"
MASTER_EMAIL=dev@exemplo.com
MASTER_PASSWORD=defina-uma-senha-forte-aqui

# Armazenamento de arquivos (fora do webroot)
STORAGE_DIR=./storage/uploads
MAX_UPLOAD_MB=5
